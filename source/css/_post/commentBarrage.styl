.comment-barrage
  position fixed
  right var(--efu-dock-right, 20px)
  bottom var(--efu-dock-bottom, 20px)
  width var(--efu-dock-width, 300px)
  padding 0
  z-index 1001
  pointer-events auto
  transition all .3s ease
  user-select none

  +maxWidth768()
    display none !important

  .comment-barrage-item
    position absolute
    right 0
    bottom 0
    min-width var(--efu-dock-width, 300px)
    max-width var(--efu-dock-width, 300px)
    width fit-content
    margin 0
    padding 0
    background transparent
    border 0
    box-shadow none
    color var(--efu-fontcolor)
    animation barrageIn .6s cubic-bezier(.42, 0, .3, 1.11)
    overflow visible

    &.out
      pointer-events none
      animation barrageOut .6s cubic-bezier(.42, 0, .3, 1.11) forwards

      .efu-dock-surface
        animation barrageSurfaceOut .6s cubic-bezier(.42, 0, .3, 1.11) forwards

    .efu-dock-surface
      min-width var(--efu-dock-width, 300px)
      max-width var(--efu-dock-width, 300px)
      min-height 80px
      max-height 150px
      padding 8px 14px
      display flex
      flex-direction column
      overflow hidden
      background var(--efu-maskbgdeep)
      border var(--style-border)
      border-radius 8px
      box-shadow var(--efu-shadow-border)
      backdrop-filter saturate(180%) blur(20px)
      -webkit-backdrop-filter saturate(180%) blur(20px)
      animation barrageSurfaceIn .6s cubic-bezier(.42, 0, .3, 1.11)
      transition border-color .3s ease, box-shadow .3s ease

    &:hover .efu-dock-surface
      border var(--style-border-hover)
      box-shadow var(--efu-shadow-main)

    .barrageHead
      height 30px
      padding 0 0 6px
      line-height 30px
      font-size 12px
      border-bottom var(--style-border)
      display flex
      justify-content space-between
      align-items center
      font-weight 700

    .barrageUser
      min-width 0
      display flex
      align-items center
      gap 8px

    .barrageAvatar
      flex 0 0 16px
      width 16px
      height 16px
      margin 0
      border-radius 50%
      object-fit cover
      background var(--efu-secondbg)

    .barrageNick
      min-width 0
      max-width 140px
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

    .barrageActions
      flex-shrink 0
      display flex
      align-items center
      gap 6px

    .barrageTitle
      appearance none
      display inline-flex
      align-items center
      justify-content center
      text-decoration none
      border 0
      color var(--efu-fontcolor)
      background var(--efu-secondbg)
      line-height 1
      height 22px
      padding 0 8px
      border-radius 4px
      font inherit
      cursor pointer
      white-space nowrap
      transition background .3s ease, color .3s ease

      &:hover,
      &:focus-visible
        background var(--efu-lighttext)
        color var(--efu-card-bg)

    .comment-barrage-close
      appearance none
      width 22px
      height 22px
      margin 0
      padding 0
      display inline-flex
      align-items center
      justify-content center
      color var(--efu-secondtext)
      background transparent
      border 0
      border-radius 4px
      cursor pointer
      line-height 1
      transition color .3s ease, background .3s ease

      &:hover,
      &:focus-visible
        color var(--efu-lighttext)
        background var(--efu-secondbg)

      .solitude
        color currentColor
        font-size 14px

    .barrageContent
      width 100%
      height calc(100% - 30px)
      max-height 48px
      margin 0
      padding 8px 0 0
      display -webkit-box
      overflow hidden
      color var(--efu-fontcolor)
      font-size 14px !important
      font-weight 400 !important
      line-height 1.3
      text-decoration none
      text-overflow ellipsis
      -webkit-box-orient vertical
      -webkit-line-clamp 2

      &:hover,
      &:focus-visible
        color var(--efu-lighttext)

      &::-webkit-scrollbar
        width 4px
        height 0

      &::-webkit-scrollbar-button
        display none
