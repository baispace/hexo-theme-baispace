//- ===========================================
//- 导航栏模板
//- ===========================================

include ./mixins/common.pug

- var disableMenuTooltips = true

//- 网站名称渲染mixin
mixin siteName()
  +link('/', '', { 
    id: 'site-name', 
    title: _p('nav.site_name_title'),
    heotip: _p('nav.site_name_title')
  })
    case theme.site.name.class
      when 'i_class'
        +icon(theme.site.name.custom, '', { style: 'font-size: 16px;' })
      when 'img'
        img(src=theme.site.name.custom, alt=config.title)
      when 'text'
        span.title= theme.site.name.custom
    +icon('fas fa-home')

nav#nav.show(data-solitude-action="onNavBlankClickCloseConsole" data-solitude-event="true")
    #nav-group
        #blog_name
            //- 分组导航按钮
            if theme.nav.group && Object.keys(theme.nav.group).length > 0
              .back-home-button(tabindex="-1")
                svg.back-home-button-icon(viewBox="0 0 24 24" fill="currentColor")
                  path(d="M6.75 2.5C9.09721 2.5 11 4.40279 11 6.75V11H6.75C4.40279 11 2.5 9.09721 2.5 6.75C2.5 4.40279 4.40279 2.5 6.75 2.5ZM6.75 13H11V17.25C11 19.5972 9.09721 21.5 6.75 21.5C4.40279 21.5 2.5 19.5972 2.5 17.25C2.5 14.9028 4.40279 13 6.75 13ZM17.25 2.5C19.5972 2.5 21.5 4.40279 21.5 6.75C21.5 9.09721 19.5972 11 17.25 11H13V6.75C13 4.40279 14.9028 2.5 17.25 2.5ZM13 13H17.25C19.5972 13 21.5 14.9028 21.5 17.25C21.5 19.5972 19.5972 21.5 17.25 21.5C14.9028 21.5 13 19.5972 13 17.25V13Z")
                include ./widgets/nav/group
            
            //- 网站名称
            +siteName()
        
        //- 页面名称遮罩
        #page-name-mask
            #page-name
                a#page-name-text(data-solitude-action="toTop" title=_p('nav.backtop') heotip=_p('nav.backtop'))= title || config.title
        
        //- 主菜单
        #menus
            include ./widgets/nav/menu.pug
        
        //- 导航左右区域
        #nav-left
        #nav-right
            include ./widgets/nav/right.pug
